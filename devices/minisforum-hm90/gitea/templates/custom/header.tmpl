<script nonce="{{ctx.CspScriptNonce}}">
  (() => {
    // A new hue only on a refresh; clicking around keeps the saved one.
    const reload = performance.getEntriesByType("navigation")[0]?.type === "reload";
    let hue = localStorage.getItem("accent-hue");
    if (reload || hue === null) {
      hue = Math.floor(Math.random() * 360);
      localStorage.setItem("accent-hue", hue);
    }
    const accent = `hsl(${hue} 65% 50%)`;
    document.documentElement.style.setProperty("--accent", accent);
    // The favicon is redrawn in the same colour.
    fetch("{{AssetUrlPrefix}}/img/logo.svg").then((r) => r.text()).then((svg) => {
      const tinted = svg.replace(/<style>.*?<\/style>/s, "").replaceAll("#1a1a1a", accent);
      const url = URL.createObjectURL(new Blob([tinted], { type: "image/svg+xml" }));
      for (const link of document.querySelectorAll('link[rel~="icon"]')) link.href = url;
    });
  })();
</script>
<style>
  /* One random hue per page load; every primary shade derives from it. */
