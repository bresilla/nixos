# Machine-specific layout generated by discio.sh; review devices before installing.
{
  disko.devices = {
    disk."disk1" = { type = "disk"; device = "/dev/mmcblk0";
      content = { type = "gpt"; partitions = {
        ESP = { priority = 1; size = "1024M"; type = "EF00";
          content = { type = "filesystem"; format = "vfat"; mountpoint = "/boot"; mountOptions = [ "umask=0077" ]; }; };
        pv = { size = "58608M"; content = { type = "lvm_pv"; vg = "pool"; }; };
      }; }; };
    lvm_vg."pool" = { type = "lvm_vg"; lvs = {
      "root" = { size = "5860M"; content = { type = "btrfs"; extraArgs = [ "-f" ]; subvolumes = { "/@root" = { mountpoint = "/"; mountOptions = [ "noatime" "compress=zstd:3" "ssd" ]; }; }; }; };
      "home" = { size = "5860M"; content = { type = "btrfs"; extraArgs = [ "-f" ]; subvolumes = { "/@home" = { mountpoint = "/home"; mountOptions = [ "noatime" "compress=zstd:3" "ssd" ]; }; }; }; };
      "nix" = { size = "46880M"; content = { type = "btrfs"; extraArgs = [ "-f" ]; subvolumes = { "/@nix" = { mountpoint = "/nix"; mountOptions = [ "noatime" "compress=zstd:3" "ssd" ]; }; }; }; };
    }; };
  };
}
