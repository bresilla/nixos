+BOOL drive_file_seek_write(DRIVE_FILE* file, UINT64 Offset)
+{
+	/* Handle both the protocol append marker and the Windows redirector marker. */
+	if ((Offset == UINT64_MAX) || (Offset == INT64_MAX))
+	{
+		const LARGE_INTEGER zero = { .QuadPart = 0 };
+		if (!file)
+			return FALSE;
+		return SetFilePointerEx(file->file_handle, zero, nullptr, FILE_END);
+	}
+	return drive_file_seek(file, Offset);
+}
