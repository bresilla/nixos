<script nonce="{{ctx.CspScriptNonce}}">
// The add-ons' pages in a repository's settings live on the options page under a #hash;
// their menu entries and panels come with the page, and the chosen one is shown alone.
(() => {
  const main = document.querySelector(".repository.settings.options .user-main-content");
  const menu = document.querySelector(".repository.settings .flex-container-nav .ui.vertical.menu");
  if (!main || !menu) return;
  const show = () => {
    const tab = location.hash.slice(1);
    const known = [...main.querySelectorAll(":scope > .settings-tab")].some((b) => b.dataset.tab === tab);
    for (const child of main.children) {
      const mine = child.classList.contains("settings-tab");
      child.classList.toggle("tw-hidden", known ? !(mine && child.dataset.tab === tab) : mine);
    }
    for (const item of menu.querySelectorAll("a.item")) {
      if (item.classList.contains("settings-tab-item")) item.classList.toggle("active", item.dataset.tab === tab);
      else if (item.getAttribute("href")?.endsWith("/settings")) item.classList.toggle("active", !known);
    }
  };
  show();
  window.addEventListener("hashchange", show);
})();
</script>
