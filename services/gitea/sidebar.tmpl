<script nonce="{{ctx.CspScriptNonce}}">
// The repository home's right sidebar comes as sections: an icon, a name and an arrow
// each. Collapsed, a section keeps its first two rows; a click toggles it and the choice
// is remembered. Radicle and the mirrors add theirs here, and a link beside the title.
(() => {
  const top = document.querySelector(".repo-home-sidebar-top");
  const [owner, repo] = location.pathname.split("/").filter(Boolean);
  if (!top || !owner || !repo) return;
  const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
  const icons = {
    // The old Network tab's: three nodes and the links between them.
    radicle: '<svg viewBox="0 0 16 16" width="16" height="16" class="svg" fill="currentColor"><circle cx="8" cy="3" r="2"/><circle cx="3" cy="12" r="2"/><circle cx="13" cy="12" r="2"/><path d="M8 5 3.6 10.3M8 5l4.4 5.3M5 12h6" stroke="currentColor" fill="none"/></svg>',
    mirror: {{svg "octicon-arrow-switch"}},
    chevron: {{svg "octicon-chevron-down"}},
    copy: {{svg "octicon-copy"}},
  };
  const remembered = (name) => { try { return localStorage.getItem(`sidebar-${name}`); } catch { return null; } };
  const remember = (name, open) => { try { localStorage.setItem(`sidebar-${name}`, open ? "open" : "closed"); } catch {} };

  // Collapsing, for gitea's sections and ours alike.
  const wire = (box) => {
    const head = box.querySelector(":scope > .sidebar-toggle");
    if (!head) return;
    const name = box.dataset.section;
    const set = (o) => box.classList.toggle("sidebar-closed", !o);
    const saved = remembered(name);
    if (saved) set(saved === "open");
    head.addEventListener("click", (e) => { if (e.target.closest("a")) return; const o = box.classList.contains("sidebar-closed"); set(o); remember(name, o); });
  };
  for (const box of top.querySelectorAll(".sidebar-section")) wire(box);

  // A section of ours, built as gitea's are: a header with icon, name and arrow, then its rows.
  const section = (name, title, rows, { status = null } = {}) => {
    const box = el("div", "sidebar-section sidebar-closed");
    box.dataset.section = name;
    const head = el("div", "repo-home-sidebar-header sidebar-head sidebar-toggle");
    head.innerHTML = `${icons[name]}<span class="sidebar-title"></span><span class="sidebar-arrow">${icons.chevron}</span>`;
    head.querySelector(".sidebar-title").textContent = title;
    // A status dot between the icon and the name, with what it means on hover.
    if (status) {
      const dot = el("span", `sidebar-dot sidebar-dot-${status.state}`);
      dot.dataset.tooltipContent = status.text;
      head.querySelector("svg").after(dot);
    }
    const body = el("div", "sidebar-body flex-relaxed-list");
    body.append(...rows);
    box.append(head, body);
    wire(box);
    return box;
  };

  // Radicle and the git mirrors: details in the sidebar, a link each beside the title.
  const short = (id) => `${id.slice(0, 10)}…${id.slice(-4)}`;
  const ago = (s) => { const m = Math.round((Date.now() / 1000 - s) / 60); return m < 1 ? "just now" : m < 60 ? `${m} min ago` : m < 1440 ? `${Math.round(m / 60)} h ago` : `${Math.round(m / 1440)} d ago`; };
  const copyable = (text, shown) => {
    const c = el("button", "sidebar-copy", shown || text);
    c.type = "button";
    c.dataset.clipboardText = text;
    c.dataset.tooltipContent = `Copy ${text}`;
    c.insertAdjacentHTML("beforeend", icons.copy);
    return c;
  };
  const row = (label, value) => { const r = el("div", "sidebar-row"); r.append(el("span", "sidebar-key", label), value instanceof Node ? value : el("span", "sidebar-value", value)); return r; };
  const external = (href, text, cls = "") => { const a = el("a", cls, text); a.href = href; a.target = "_blank"; a.rel = "noopener"; return a; };
  const json = (u) => fetch(u).then((r) => (r.ok ? r.json() : null)).catch(() => null);
  const explorer = (rid) => `https://app.radicle.xyz/nodes/iris.radicle.xyz/${rid}`;
  const arrows = { push: "↗", pull: "↙", "two-way": "↔" };
  const modes = { push: "Pushed to", pull: "Pulled from", "two-way": "Kept in sync with" };

  // Beside the title: an icon and a name opening the other copy, its state on hover.
  const labels = document.getElementById("repo-title-labels");
  const titleLink = (href, icon, text, status) => {
    if (!labels) return;
    // Gitea's own header button, as RSS, Watch, Star and Fork are.
    const a = external(href, "", "ui compact small basic button title-link");
    a.innerHTML = icon;
    a.append(el("span", "", text));
    a.dataset.tooltipContent = status.text;
    labels.append(a);
  };

  Promise.all([
    json(`{{AppSubUrl}}/-/radicle/${owner.toLowerCase()}/${repo.toLowerCase()}.json`),
    json(`{{AppSubUrl}}/-/mirror/${owner.toLowerCase()}/${repo.toLowerCase()}.json`),
  ]).then(([rad, mirror]) => {
    const added = [];
    if (rad && rad.rid) {
      const seeds = rad.seeds || [];
      const synced = seeds.filter((s) => s.status === "synced").length;
      const state = synced ? { state: "ok", text: `On Radicle: ${synced} of ${seeds.length} seeds up to date` } : { state: "warn", text: "On Radicle: no seed up to date yet" };
      const bar = el("span", "sidebar-seeds");
      bar.innerHTML = `<span class="sidebar-bar"><span style="width:${seeds.length ? (100 * synced) / seeds.length : 0}%"></span></span>`;
      bar.append(el("span", "", `${synced}/${seeds.length}`));
      bar.dataset.tooltipContent = `${synced} synced, ${seeds.length - synced} behind`;
      const rows = [row("ID", copyable(rad.rid, short(rad.rid))), row("Seeds", bar)];
      const dels = (rad.delegates || []).map((d) => d.alias || short(d.did.replace("did:key:", ""))).join(", ");
      if (dels) rows.push(row("Delegate", dels));
      rows.push(row("Clone", copyable(`rad clone ${rad.rid}`, "rad clone")));
      rows.push(row("", external(explorer(rad.rid), "Open in explorer ↗", "sidebar-more")));
      added.push(section("radicle", "Radicle", rows, { status: state }));
      titleLink(explorer(rad.rid), icons.radicle, "Radicle", state);
    }
    const links = (mirror && mirror.links) || [];
    if (links.length) {
      const bad = links.filter((l) => l.state !== "ok");
      const state = bad.length ? { state: "warn", text: bad.map((l) => `${l.host}: ${l.note || "not in sync"}`).join("; ") } : { state: "ok", text: "All mirrors in sync" };
      added.push(section("mirror", "Mirror", links.map((link) => {
        const r = el("div", "sidebar-row sidebar-link");
        r.append(el("span", "sidebar-arrowhead", arrows[link.mode] || "↗"), external(`https://${link.host}/${link.path}`, `${link.host}/${link.path}`, "sidebar-value"));
        r.append(el("span", `sidebar-dot sidebar-dot-${link.state === "ok" ? "ok" : "warn"}`));
        r.dataset.tooltipContent = `${modes[link.mode] || "Mirrored to"} ${link.host}: ${link.note || "not in sync"}${link.when ? `, ${ago(link.when)}` : ""}`;
        return r;
      }), { status: state }));
      for (const link of links) {
        const ok = link.state === "ok";
        titleLink(`https://${link.host}/${link.path}`, icons.mirror, link.host, { state: ok ? "ok" : "warn", text: `${modes[link.mode] || "Mirrored to"} ${link.host}/${link.path}: ${link.note || "not in sync"}${link.when ? `, ${ago(link.when)}` : ""}` });
      }
    }
    const desc = top.querySelector('.sidebar-section[data-section="description"]');
    if (desc) desc.after(...added); else top.append(...added);
  });
})();
</script>
<style>
/* Cards drawn like the file table: its border, radius, header row and 8px 10px cells. */
.repo-home-sidebar-top { gap: 10px !important; }
/* The bottom block is rendered inside the top one, so its cards join the same column. */
.repo-home-sidebar-top > .repo-home-sidebar-bottom { display: contents; }
.sidebar-section { display: flex; flex-direction: column; margin: 0 !important; border: 1px solid var(--color-secondary); border-radius: var(--border-radius); background: var(--color-box-body); }
.sidebar-head { display: flex; align-items: center; gap: 0.5em; margin: 0 !important; padding: 8px 10px; font-size: 14px; background: var(--color-box-header); border-radius: var(--border-radius) var(--border-radius) 0 0; }
.sidebar-body { padding: 8px 10px; border-top: 1px solid var(--color-secondary); }
.sidebar-head > .svg:first-child { color: var(--color-text-light-2); }
.sidebar-toggle { cursor: pointer; user-select: none; }
.sidebar-toggle:hover .sidebar-title { color: var(--color-primary); }
.sidebar-arrow { margin-left: auto; display: flex; color: var(--color-text-light-2); transition: transform 0.15s; }
.sidebar-closed .sidebar-arrow { transform: rotate(-90deg); }
.sidebar-body { gap: 8px !important; }
.sidebar-body > :empty { display: none; }
.sidebar-closed .sidebar-body > :nth-child(n+3) { display: none !important; }
.sidebar-closed .repo-description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sidebar-dot { width: 0.55em; height: 0.55em; border-radius: 50%; flex-shrink: 0; display: inline-block; }
.sidebar-dot-ok { background: var(--color-green); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-green) 25%, transparent); }
.sidebar-dot-warn { background: var(--color-orange); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-orange) 25%, transparent); }
.sidebar-row { display: flex; gap: 0.6em; align-items: center; min-width: 0; }
.sidebar-key { flex: 0 0 4.8em; color: var(--color-text-light-2); }
.sidebar-value { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sidebar-copy { display: inline-flex; align-items: center; gap: 0.4em; min-width: 0; padding: 0.15em 0.5em; border: 1px solid var(--color-secondary); border-radius: var(--border-radius, 4px); background: var(--color-markup-code-inline, var(--color-secondary-bg)); color: var(--color-text); font: 0.92em var(--fonts-monospace); cursor: pointer; }
.sidebar-copy .svg { width: 12px; height: 12px; color: var(--color-text-light-2); }
.sidebar-copy:hover { border-color: var(--color-primary); }
.sidebar-copy:hover .svg { color: var(--color-primary); }
.sidebar-seeds { display: inline-flex; align-items: center; gap: 0.5em; flex: 1; }
.sidebar-bar { flex: 1; max-width: 8em; height: 6px; border-radius: 3px; background: var(--color-secondary); overflow: hidden; }
.sidebar-bar > span { display: block; height: 100%; background: var(--color-green); }
.sidebar-link .sidebar-value { flex: 1; color: var(--color-text); }
.sidebar-link .sidebar-value:hover { color: var(--color-primary); }
.sidebar-arrowhead { width: 1em; text-align: center; color: var(--color-text-light-2); }
.sidebar-more { font-size: 0.92em; }
.title-link { margin: 0 !important; }
</style>
