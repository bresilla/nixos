--- /dev/null
+++ b/phone_power.c
@@ -0,0 +1,83 @@
+/* Optional phone-greeter policy; unset CAGE_PHONE_IDLE_SECONDS keeps stock behavior.
+ * Output-power implementation is from Cage PR #529. Keep outputs in the layout
+ * so Morf and the touchscreen survive a powered-off panel.
+ */
+#include <stdlib.h>
+#include <wlr/types/wlr_output_layout.h>
+#include <wlr/util/log.h>
+
+#include "output.h"
+#include "phone_power.h"
+
+static void
+set_power(struct cg_server *server, bool on)
+{
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		output_set_power(output, on);
+	}
+}
+
+static int
+handle_idle(void *data)
+{
+	set_power(data, false);
+	return 0;
+}
+
+bool
+phone_power_init(struct cg_server *server)
+{
+	const char *value = getenv("CAGE_PHONE_IDLE_SECONDS");
+	if (!value) {
+		return true;
+	}
+	char *end;
+	long seconds = strtol(value, &end, 10);
+	if (*end || seconds < 1 || seconds > 86400) {
+		wlr_log(WLR_ERROR, "CAGE_PHONE_IDLE_SECONDS must be between 1 and 86400");
+		return false;
+	}
+	server->phone_idle_msec = (int)seconds * 1000;
+	server->phone_idle_timer = wl_event_loop_add_timer(
+		wl_display_get_event_loop(server->wl_display), handle_idle, server);
+	if (!server->phone_idle_timer) {
+		return false;
+	}
+	return wl_event_source_timer_update(server->phone_idle_timer, server->phone_idle_msec) == 0;
+}
+
+void
+phone_power_finish(struct cg_server *server)
+{
+	if (server->phone_idle_timer) {
+		wl_event_source_remove(server->phone_idle_timer);
+		server->phone_idle_timer = NULL;
+	}
+}
+
+void
+phone_power_activity(struct cg_server *server)
+{
+	if (!server->phone_idle_timer) {
+		return;
+	}
+	set_power(server, true);
+	wl_event_source_timer_update(server->phone_idle_timer, server->phone_idle_msec);
+}
+
+void
+phone_power_toggle(struct cg_server *server)
+{
+	bool powered = false;
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		if (wlr_output_layout_get(server->output_layout, output->wlr_output)) {
+			powered |= output->wlr_output->enabled;
+		}
+	}
+	set_power(server, !powered);
+	/* A power press is handled once, without an idle-resume callback that
+	 * would immediately wake the panel again. Key release is consumed too. */
+	wl_event_source_timer_update(server->phone_idle_timer, powered ? 0 : server->phone_idle_msec);
+}
